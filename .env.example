# Letopia – Konfiguration
# Für die lokale Entwicklung als .env kopieren. Auf dem Server legt der Installer
# die Datei /etc/letopia/letopia.env automatisch an.

# Adresse und Port, auf denen der Node-Server lauscht.
# Hinter Nginx immer 127.0.0.1 verwenden.
HOST=127.0.0.1
PORT=3000

# Öffentliche Adresse der Website (für Links in Discord-Nachrichten, Sitemap, OG-Tags).
SITE_URL=http://localhost:3000

# Ordner für Datenbank, Uploads, Cache und Backups.
DATA_DIR=./data

# "true", wenn ein Reverse-Proxy (Nginx) davor läuft – dann werden
# X-Forwarded-For / X-Forwarded-Proto ausgewertet.
TRUST_PROXY=false

# production | development
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info
